import time
import sys

def escrever_devagar(texto, velocidade=0.05):
    for letra in texto:
        sys.stdout.write(letra)
        sys.stdout.flush()
        time.sleep(velocidade)
    print()  # pula linha no final

print("📖 Vamos criar uma história completamente maluca! 😜")
print("Responda as perguntas abaixo com criatividade!\n")

# Pedindo as 6 palavras ao usuário
lugar = input("🌍 Diga um lugar: ")
